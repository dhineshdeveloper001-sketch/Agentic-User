# ==============================================================================
# AI IT Support Agent - Environment Configuration Template
# Copy this file to .env and add your actual API keys.
# .env is ignored by git and will never be committed.
# ==============================================================================

# LLM / OpenAI Configuration (Optional - offline deterministic fallback active if empty)
OPENAI_API_KEY=your-api-key-here

# Base URL for custom endpoints (e.g., http://localhost:11434/v1 for local Ollama)
OPENAI_BASE_URL=

# Model selection (e.g., gpt-4o-mini, llama3.2, mistral)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# RAG & Semantic Search Configuration
CONFIDENCE_THRESHOLD=0.3
RAG_TOP_K=10
RERANKER_TOP_N=3

# ChromaDB Vector Storage Directory
CHROMA_PERSIST_DIR=./backend/data/chromadb

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
